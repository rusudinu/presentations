% ============================================================================
% beamerthemeupbminimal.sty  v3
% The Beamer theme of the UPB mobile courses (Application Development for Mobile
% Devices, Mobile and Embedded Computing), set like a technical manual: a running
% head over a strong rule, numbered chapter openers with a real table of contents,
% booktabs tables, ruled forms for acceptance criteria, square corners throughout.
%
% Written for two readers: the back row of a lecture hall looking at a projector,
% and a student reading the PDF next to an IDE. Every text color passes WCAG AA
% (4.5:1) on white and on the panel color.
%
%   ink 16181D · ink soft 474B55 · gray 6B6F7A (page furniture only)
%   hairline C8CBD2 · panel F0F1F4
%   cobalt 2449B0 = the one accent · orange A84300 = embedded topics only
%   red C4122F = warnings only
%
% Type: Atkinson Hyperlegible Next and Atkinson Hyperlegible Mono (Braille Institute),
% drawn so that similar characters (Il1, O0, rn/m) stay distinct for low-vision readers.
% Both ship with TeX Live, so every machine and the CI render identical PDFs. Do not switch
% to system fonts: the build would stop being reproducible.
%
% Usage:  \usetheme{upbminimal}         lectures
%         \usetheme[lab]{upbminimal}    labs (the title slide omits the week)
% Compile with xelatex or lualatex.
% ============================================================================
\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{beamerthemeupbminimal}[2026/09/30 v3.0 UPB technical-manual beamer theme]

\RequirePackage{etoolbox}
\RequirePackage{xcolor}
\RequirePackage{tikz}
\usetikzlibrary{arrows.meta}
\RequirePackage{booktabs}
\RequirePackage{colortbl}
\RequirePackage{array}
\RequirePackage{listings}
\RequirePackage{fontawesome5}
\RequirePackage{tcolorbox}
\tcbuselibrary{skins}
\RequirePackage{fontspec}

% ------------------------------------------------------------ options -------
\newif\ifupb@lab
\DeclareOption{lab}{\upb@labtrue}
\DeclareOption{noprogress}{}% kept so older decks compile; v3 has no progress line
\ProcessOptions\relax

% ------------------------------------------------------------- colors -------
\definecolor{upbInk}{HTML}{16181D}
\definecolor{upbInkSoft}{HTML}{474B55}
\definecolor{upbGray}{HTML}{6B6F7A}
\definecolor{upbHairline}{HTML}{C8CBD2}
\definecolor{upbPanel}{HTML}{F0F1F4}
\definecolor{upbBlue}{HTML}{2449B0}
\definecolor{upbOrange}{HTML}{A84300}
\definecolor{upbRed}{HTML}{C4122F}
\definecolor{upbWhite}{HTML}{FFFFFF}
\definecolor{upbKeyword}{HTML}{2449B0}
\definecolor{upbString}{HTML}{1E7A3A}
\definecolor{upbComment}{HTML}{6B6F7A}
\colorlet{upbAccent}{upbBlue}

% -------------------------------------------------------------- fonts -------
% The mono is scaled to 0.912 so a code line holds as many characters as before (0.6 em).
\setsansfont{AtkinsonHyperlegibleNext}[Extension=.otf,UprightFont=*-Regular,BoldFont=*-Bold,
  ItalicFont=*-RegularItalic,BoldItalicFont=*-BoldItalic,
  FontFace={sb}{n}{*-SemiBold},FontFace={sb}{it}{*-SemiBoldItalic},FontFace={l}{n}{*-Light}]
\setmonofont{AtkinsonHyperlegibleMono}[Extension=.otf,UprightFont=*-Regular,BoldFont=*-Bold,
  ItalicFont=*-RegularItalic,BoldItalicFont=*-BoldItalic,Scale=0.912]
% Atkinson Hyperlegible Mono has no backtick (U+0060), which Go struct tags and shell need.
% Code blocks borrow that one glyph from DejaVu Sans Mono, scaled to the same advance width.
\newfontfamily\upb@backtickfont{DejaVuSansMono}[Extension=.ttf,Scale=0.957]
\newcommand\upb@backtick{{\upb@backtickfont\char"60}}
\renewcommand\familydefault{\sfdefault}
\newcommand\upb@sb{\fontseries{sb}\selectfont}
\newcommand\upb@light{\fontseries{l}\selectfont}

\setbeamerfont{normal text}{size=\fontsize{10}{13.5}}
\setbeamerfont{runninghead}{size=\fontsize{7.5}{9}}
\setbeamerfont{frametitle}{size=\fontsize{17}{20}}
\setbeamerfont{framesubtitle}{size=\fontsize{10}{12}}
\setbeamerfont{title}{size=\fontsize{28}{32}}
\setbeamerfont{subtitle}{size=\fontsize{12.5}{16}}
\setbeamerfont{divider}{size=\fontsize{24}{28}}
\setbeamerfont{partnumber}{size=\fontsize{96}{90}}
\setbeamerfont{footline}{size=\fontsize{6.5}{8}}
\setbeamerfont{label}{size=\fontsize{8}{10}}
\setbeamerfont{caption}{size=\fontsize{8}{10}}
\setbeamerfont{small}{size=\fontsize{8.5}{11}}
\setbeamerfont{agenda}{size=\fontsize{9}{11}}

% ------------------------------------------------------ course metadata -----
% \course[ADMD]{Application Development for Mobile Devices}: the short form goes in the cover's title block.
% \materials{github.com/owner/repo}: where the PDF and the code live, on the title slide.
% \authorlabel{Speaker}: the label of the author field on the cover (default "Lecturer").
\def\upb@course{}\def\upb@courseshort{}\def\upb@decklabel{}\def\upb@materials{}\def\upb@authorlabel{Lecturer}
\newcommand\course[2][]{\def\upb@course{#2}\def\upb@courseshort{#1}}
\newcommand\authorlabel[1]{\def\upb@authorlabel{#1}}
\newcommand\decklabel[1]{\def\upb@decklabel{#1}}
\newcommand\materials[1]{\def\upb@materials{#1}}

% --------------------------------------------------------- base colors ------
\setbeamercolor{normal text}{fg=upbInk,bg=upbWhite}
\setbeamercolor{background canvas}{bg=upbWhite}
\setbeamercolor{structure}{fg=upbAccent}
\setbeamercolor{frametitle}{fg=upbInk,bg=}
\setbeamercolor{framesubtitle}{fg=upbInkSoft}
\setbeamercolor{footline}{fg=upbGray,bg=}
\setbeamercolor{alerted text}{fg=upbAccent}
\setbeamercolor{item}{fg=upbAccent}
\setbeamercolor{enumerate item}{fg=upbAccent}
\setbeamercolor{caption name}{fg=upbGray}
\setbeamercolor{caption}{fg=upbInkSoft}
\setbeamercolor{block title}{fg=upbInk,bg=upbPanel}
\setbeamercolor{block body}{fg=upbInk,bg=upbPanel}

% ------------------------------------------------------------ layout --------
\setbeamertemplate{navigation symbols}{}
\setbeamersize{text margin left=10mm,text margin right=10mm}
\setbeamertemplate{headline}{}
\setbeamertemplate{caption}[numbered]
\setlength{\parskip}{4pt}

% frame options: [eyebrow=Debugging], [embedded], [time=30 min] (a lab task's budget)
\def\upb@eyebrow{}\def\upb@time{}
\define@key{beamerframe}{eyebrow}{\def\upb@eyebrow{#1}}
\define@key{beamerframe}{embedded}[true]{\colorlet{upbAccent}{upbOrange}}
\define@key{beamerframe}{time}{\def\upb@time{#1}}
% Beamer applies frame options outside the frame group, so reset them on its internal
% "environment" key, which it sets on every frame before the user's options.
\AtBeginDocument{\pretocmd{\KV@beamerframe@environment}{\def\upb@eyebrow{}\def\upb@time{}\colorlet{upbAccent}{upbBlue}}{}{%
  \PackageWarning{beamerthemeupbminimal}{Could not hook frame option reset}}}

% TikZ's align=left fixes \spaceskip in the body font's em, which squeezes the word spaces of
% a large title to a third of their width. Reset it so each size uses its own spacing.
\newcommand\upb@nohyph{\hyphenpenalty=10000 \exhyphenpenalty=10000 \raggedright\spaceskip=0pt\xspaceskip=0pt\relax}
\newcommand\upb@rule[1]{\par\nointerlineskip{\color{upbInk}\hrule height #1}}
\newcommand\upb@vhairline{\par\nointerlineskip{\color{upbHairline}\hrule height 0.4pt}}

% Running head over a strong rule, then the title: the page header of a manual.
% The running head carries the section (the eyebrow) and, on lab tasks, the time budget.
\setbeamertemplate{frametitle}{%
  \vskip 4mm
  {\usebeamerfont{runninghead}\upb@sb\color{upbAccent}%
    \ifdefempty{\upb@eyebrow}{\strut}{\upb@eyebrow}%
    \ifdefempty{\upb@time}{}{{\color{upbInkSoft}\mdseries\hfill\faClock[regular]\ \upb@time}}\par}%
  \vskip 0.8mm\upb@rule{0.8pt}\vskip 2.3mm
  {\usebeamerfont{frametitle}\upb@sb\usebeamercolor[fg]{frametitle}\upb@nohyph\insertframetitle\par}%
  \ifx\insertframesubtitle\@empty\else
    \vskip 1mm{\usebeamerfont{framesubtitle}\usebeamercolor[fg]{framesubtitle}\insertframesubtitle\par}\fi
  \vskip 2.2mm
}

% Footer: course and deck left, page right. Every page is numbered, including the cover and
% the closing slide, so "page 14" in the room is page 14 of the PDF.
\newcommand\upb@lastpage{\ifcsempty{beamer@endpageofdocument}{1}{\beamer@endpageofdocument}}
\setbeamertemplate{footline}{%
  \begin{beamercolorbox}[wd=\paperwidth,ht=4.5mm,dp=2.5mm,leftskip=10mm,rightskip=10mm]{footline}%
    \usebeamerfont{footline}\color{upbGray}%
    \upb@course\ifdefempty{\upb@decklabel}{}{\ \textperiodcentered\ \upb@decklabel}%
    \hfill\insertpagenumber\,/\,\upb@lastpage
  \end{beamercolorbox}}

% ------------------------------------------------------ lists ---------------
% Items hang from an en dash, the list mark of European technical documents.
\setlength{\leftmargini}{4.2mm}
\setlength{\leftmarginii}{4.2mm}
\setbeamertemplate{itemize item}{{\color{upbAccent}\upb@sb\textendash}}
\setbeamertemplate{itemize subitem}{{\color{upbGray}\textendash}}
\setbeamertemplate{itemize subsubitem}{{\color{upbGray}\textendash}}
\setbeamertemplate{enumerate item}{\color{upbAccent}\upb@sb\insertenumlabel.}
\AtBeginEnvironment{itemize}{\setlength\itemsep{5pt}\setlength\labelsep{1.8mm}}
\AtBeginEnvironment{enumerate}{\setlength\itemsep{4pt}\setlength\leftmargini{6mm}\setlength\labelsep{1.5mm}}

% a semibold lead with a supporting line under it
\newcommand\lead[2]{{\upb@sb #1}\par{\color{upbInkSoft}#2}\par}
% supporting text
\newcommand\muted[1]{{\color{upbInkSoft}#1}}
% inline code
\setlength{\fboxsep}{1.2pt}
\newcommand\code[1]{\colorbox{upbPanel}{\ttfamily\fontsize{8.5}{10}\selectfont\color{upbInk}#1}}
% a small label in sentence case
\newcommand\upb@label[1]{{\usebeamerfont{label}\upb@sb\color{upbInkSoft}#1}}
% key/value: the label above the value
\newcommand\kv[2]{\upb@label{#1}\par{\upb@nohyph#2}\par}

% ------------------------------------------------------ parts (agenda) ------
% Each \divider records its number, title and page in the .aux file, so every divider can
% print the whole table of contents with page numbers. Entries are PDF links.
\def\upb@nparts{0}
\newcommand\upb@regpart[3]{\csgdef{upb@part@#1}{#2}\csgdef{upb@partpage@#1}{#3}%
  \ifnum#1>\upb@nparts\relax\xdef\upb@nparts{#1}\fi}
\newcommand\upb@agendarow[1]{%
  \ifcsdef{upb@part@#1}{%
  \hbox to \linewidth{%
    \ifnum#1=\value{section}\relax\def\upb@c{upbInk}\upb@sb\else\def\upb@c{upbInkSoft}\fi
    \hyperlink{page.\csuse{upb@partpage@#1}}{%
      \hbox to 6mm{{\color{\ifnum#1=\value{section}upbAccent\else upbGray\fi}#1}\hfil}%
      {\color{\upb@c}\csuse{upb@part@#1}}}%
    \hfill{\color{upbGray}\mdseries\csuse{upb@partpage@#1}}}\par}{}}

% ------------------------------------------------------ cover and dividers --
% Header shared by the cover, the dividers and the closing slide: course left, deck right,
% over a strong rule.
\newcommand\upb@pagehead{%
  \begin{tikzpicture}[remember picture,overlay]
    \node[anchor=south west,inner sep=0pt] at ([xshift=10mm,yshift=-10.6mm]current page.north west)
      {\usebeamerfont{runninghead}\color{upbInkSoft}\upb@course};
    \node[anchor=south east,inner sep=0pt] at ([xshift=-10mm,yshift=-10.6mm]current page.north east)
      {\usebeamerfont{runninghead}\upb@sb\color{upbAccent}\upb@decklabel};
    \fill[upbInk] ([xshift=10mm,yshift=-11.6mm]current page.north west) rectangle ([xshift=-10mm,yshift=-12.4mm]current page.north east);
  \end{tikzpicture}}

% The cover ends in a title block, the way an engineering drawing does: who, which course,
% which deck, and where the files are.
\newcommand\upb@tbcell[2]{\begin{minipage}[t]{\upb@tbw}\upb@nohyph
  {\usebeamerfont{label}\color{upbGray}#1\par}\vskip 0.8mm{\fontsize{9}{11.5}\selectfont\color{upbInk}#2\par}\end{minipage}}
\newlength\upb@tbw
\setbeamertemplate{title page}{%
  \upb@pagehead
  \begin{tikzpicture}[remember picture,overlay]
    \node[anchor=west,inner sep=0pt,text width=134mm,align=left,execute at begin node=\upb@nohyph]
      at ([xshift=10mm,yshift=7mm]current page.west) {%
        {\usebeamerfont{title}\upb@sb\color{upbInk}\inserttitle\par}%
        \ifx\insertsubtitle\@empty\else\vskip 4mm{\usebeamerfont{subtitle}\color{upbInkSoft}\insertsubtitle\par}\fi};
    \fill[upbInk] ([xshift=10mm,yshift=24.4mm]current page.south west) rectangle ([xshift=-10mm,yshift=24mm]current page.south east);
    \node[anchor=north west,inner sep=0pt] at ([xshift=10mm,yshift=21.5mm]current page.south west) {%
      \setlength\upb@tbw{34mm}\upb@tbcell{\upb@authorlabel}{\insertauthor}\hspace{3mm}%
      \setlength\upb@tbw{20mm}%
      \ifdefempty{\upb@courseshort}{}{\upb@tbcell{Course}{\upb@courseshort}\hspace{3mm}}%
      \ifupb@lab\else\ifx\insertdate\@empty\else\upb@tbcell{Date}{\insertdate}\hspace{3mm}\fi\fi
      \setlength\upb@tbw{60mm}%
      \ifx\insertinstitute\@empty\else\upb@tbcell{Affiliation}{\insertinstitute}\hspace{3mm}\fi
      \ifdefempty{\upb@materials}{}{\setlength\upb@tbw{80mm}\upb@tbcell{Slides and code}{\upb@materials}}};
  \end{tikzpicture}}
\date{}

% \titleframe : the cover
\newcommand\titleframe{\begin{frame}[plain]\titlepage\end{frame}}

% \divider{Part N · Name}{Title}[Topics] : a chapter opener. The large numeral is the part;
% below it, the lecture's table of contents with the current part in ink. Also a PDF bookmark.
\NewDocumentCommand\divider{m m O{}}{%
  \section{#2}%
  \immediate\write\@auxout{\string\upb@regpart{\thesection}{\unexpanded{#2}}{\the\c@page}}%
  \begin{frame}[plain]\upb@pagehead
    \begin{tikzpicture}[remember picture,overlay]
      \node[anchor=north west,inner sep=0pt] at ([xshift=8.6mm,yshift=-17mm]current page.north west)
        {\usebeamerfont{partnumber}\upb@light\color{upbAccent}\thesection};
      \node[anchor=north west,inner sep=0pt,text width=94mm,align=left,execute at begin node=\upb@nohyph]
        at ([xshift=56mm,yshift=-21.5mm]current page.north west) {%
        {\usebeamerfont{divider}\upb@sb\color{upbInk}#2\par}%
        \ifblank{#3}{}{\vskip 3mm{\usebeamerfont{subtitle}\color{upbInkSoft}#3\par}}};
      \ifnum\upb@nparts>1
      \node[anchor=south west,inner sep=0pt,text width=94mm,align=left]
        at ([xshift=56mm,yshift=11mm]current page.south west) {%
        \usebeamerfont{agenda}\setlength\parskip{1.6mm}%
        {\usebeamerfont{label}\upb@sb\color{upbGray}Contents\hfill Page\par}\vskip -0.6mm
        {\color{upbHairline}\hrule height 0.4pt}\vskip 1.4mm
        \foreach \upb@i in {1,...,\upb@nparts}{\upb@agendarow{\upb@i}}};
      \fi
    \end{tikzpicture}
  \end{frame}}

% \closingframe{Title}{supporting line}
\NewDocumentCommand\closingframe{m m}{%
  \begin{frame}[plain]\upb@pagehead
    \begin{tikzpicture}[remember picture,overlay]
      \node[anchor=west,inner sep=0pt,text width=134mm,align=left,execute at begin node=\upb@nohyph]
        at ([xshift=10mm,yshift=2mm]current page.west) {%
        {\usebeamerfont{divider}\upb@sb\color{upbInk}#1\par}\vskip 3.5mm
        {\usebeamerfont{subtitle}\color{upbInkSoft}#2\par}};
    \end{tikzpicture}
  \end{frame}}

% ------------------------------------------------------ grid ----------------
% \begin{grid}[2]  \cell[\faBug]{Title}{Text} ... \end{grid}
% The icon sits inline before the title, at text size: an index mark, not an illustration.
\newlength\upb@cellw
\newenvironment{grid}[1][2]{%
  \par\setlength\upb@cellw{\dimexpr(\textwidth-5mm*\numexpr#1-1\relax)/#1-0.2pt\relax}%
  \setlength\lineskip{6mm}\setlength\lineskiplimit{0pt}\setlength\parskip{0pt}%
  \ifdim\lastskip=0pt\vskip 3.5mm\fi% right after a paragraph: keep the first row off its last line
  \nointerlineskip\noindent\raggedright\ignorespaces}{\par}
\NewDocumentCommand\cell{O{} m m}{%
  \begin{minipage}[t]{\upb@cellw}\raggedright\setlength\parskip{0pt}%
    {\upb@sb\ifblank{#1}{}{{\color{upbAccent}#1}\hspace{1.6mm}}#2\par}\vskip 0.8mm
    {\color{upbInkSoft}\usebeamerfont{small}#3\par}%
  \end{minipage}\hspace{5mm}\ignorespaces}
% \bignum{16.7 ms}{per frame at 60 Hz}
\NewDocumentCommand\bignum{m m}{%
  \begin{minipage}[t]{\upb@cellw}\raggedright\setlength\parskip{0pt}%
    {\fontsize{28}{30}\selectfont\upb@sb\color{upbAccent}#1\par}\vskip 1.5mm
    {\color{upbInkSoft}\usebeamerfont{small}#2\par}%
  \end{minipage}\hspace{5mm}\ignorespaces}

% \objectivesframe{...cells...} : what the student can do after the lecture
\newcommand\objectivesframe[1]{%
  \begin{frame}[eyebrow=Today]{What you should leave with}
    \vskip 3mm\begin{grid}[2]#1\end{grid}
  \end{frame}}

% ------------------------------------------------------ takeaway ------------
% \begin{takeaway}{Semibold lead.} supporting sentence \end{takeaway}  (at the bottom)
\newenvironment{takeaway}[1]{%
  \par\vskip 1.5mm plus 1filll
  {\color{upbInk}\hrule height 0.8pt}\vskip 1.8mm\noindent
  \begin{minipage}{\textwidth}\raggedright\setlength\parskip{0pt}%
  {\upb@sb\color{upbAccent}#1}\ \color{upbInkSoft}\ignorespaces
}{\end{minipage}\par\vskip 1mm}

% ------------------------------------------------------ notes ---------------
% Square shaded panels with a run-in label, like the notes of a printed manual.
\newtcolorbox{panel}[1][]{enhanced,colback=upbPanel,colframe=upbPanel,boxrule=0pt,sharp corners,
  left=2.8mm,right=2.8mm,top=1.8mm,bottom=1.8mm,boxsep=0pt,fontupper=\usebeamerfont{normal text}\upb@nohyph,#1}
\newenvironment{hint}[1][Hint]{\begin{panel}{\upb@sb\color{upbAccent}\faLightbulb[regular]\ #1}\par\vskip 0.6mm}{\end{panel}}
\newenvironment{warning}[1][Watch out]{\begin{panel}[borderline north={0.8pt}{0pt}{upbRed}]%
  {\upb@sb\color{upbRed}\faExclamationTriangle\ #1}\par\vskip 0.6mm}{\end{panel}}

% ------------------------------------------------------ tables --------------
% booktabs with a strong top and bottom rule in ink and hairlines inside.
\arrayrulecolor{upbHairline}
\setlength\heavyrulewidth{0.8pt}
\setlength\lightrulewidth{0.4pt}
\setlength\cmidrulewidth{0.4pt}
\setlength\aboverulesep{0.6ex}
\setlength\belowrulesep{0.8ex}
\renewcommand\arraystretch{1.25}
\let\upb@toprule\toprule \let\upb@bottomrule\bottomrule
\renewcommand\toprule{\arrayrulecolor{upbInk}\upb@toprule\arrayrulecolor{upbHairline}}
\renewcommand\bottomrule{\arrayrulecolor{upbInk}\upb@bottomrule\arrayrulecolor{upbHairline}}
\newcommand\thead[1]{{\upb@sb\color{upbInk}#1}}

% ------------------------------------------------------ code ----------------
\lstdefinelanguage{Dart}{
  morekeywords={abstract,as,assert,async,await,base,break,case,catch,class,const,continue,covariant,
    default,deferred,do,dynamic,else,enum,export,extends,extension,external,factory,false,final,
    finally,for,Function,get,hide,if,implements,import,in,interface,is,late,library,mixin,new,null,
    on,operator,part,required,rethrow,return,sealed,set,show,static,super,switch,sync,this,throw,
    true,try,typedef,var,void,when,while,with,yield},
  morekeywords=[2]{int,double,num,String,bool,List,Map,Set,Future,Stream,Object,Widget,
    BuildContext,State,StatelessWidget,StatefulWidget,Iterable,Duration},
  sensitive=true,morecomment=[l]{//},morecomment=[s]{/*}{*/},
  morestring=[b]",morestring=[b]'}
\lstdefinelanguage{Kotlin}{
  morekeywords={abstract,actual,annotation,as,break,by,catch,class,companion,const,constructor,
    continue,crossinline,data,do,else,enum,expect,external,false,final,finally,for,fun,get,if,
    import,in,infix,init,inline,inner,interface,internal,is,lateinit,noinline,null,object,open,
    operator,out,override,package,private,protected,public,reified,return,sealed,set,super,
    suspend,tailrec,this,throw,true,try,typealias,val,var,vararg,when,where,while},
  morekeywords=[2]{Int,Long,Double,String,Boolean,List,Map,Set,Unit,Any,Nothing},
  sensitive=true,morecomment=[l]{//},morecomment=[s]{/*}{*/},morestring=[b]"}
\lstdefinelanguage{Go}{
  morekeywords={break,case,chan,const,continue,default,defer,else,fallthrough,for,func,go,goto,
    if,import,interface,map,package,range,return,select,struct,switch,type,var,nil,true,false},
  morekeywords=[2]{int,int32,int64,uint8,uint16,uint32,float32,float64,string,bool,byte,error,
    context,time},
  sensitive=true,morecomment=[l]{//},morecomment=[s]{/*}{*/},morestring=[b]",morestring=[b]`}
\lstdefinelanguage{YAML}{
  sensitive=false,morecomment=[l]{\#},morestring=[b]',morestring=[b]",
  keywords={true,false,null},moredelim=[l][\color{upbKeyword}]{:}}

% A wrapped code line starts with a gray arrow, so nobody copies it as two commands. The arrow
% is built outside listings, which would otherwise typeset the color spec with its own catcodes.
\newsavebox\upb@wrapmark
\AtBeginDocument{\sbox\upb@wrapmark{\textcolor{upbGray}{$\hookrightarrow$}\ }}
% Code is 8.5pt when a block spans the text width and 8pt inside a column, where lines are
% short. (Beamer's columns shrink \textwidth, so compare against the page instead.)
\newcommand\upb@codesize{\ifdim\linewidth>0.7\paperwidth\fontsize{8.5}{10.6}\else\fontsize{8}{10.2}\fi\selectfont}
\lstset{
  basicstyle=\ttfamily\upb@codesize\color{upbInk},
  keywordstyle=\color{upbKeyword},
  keywordstyle=[2]\color{upbInk}\bfseries,
  commentstyle=\color{upbComment}\itshape,
  stringstyle=\color{upbString},
  backgroundcolor=\color{upbPanel},
  frame=single,framerule=0pt,
  framexleftmargin=3mm,framexrightmargin=3mm,framextopmargin=1.2mm,framexbottommargin=1.2mm,
  xleftmargin=3mm,xrightmargin=3mm,
  aboveskip=2mm,belowskip=2mm,
  columns=fullflexible,keepspaces=true,showstringspaces=false,upquote=true,
  tabsize=2,breaklines=true,breakatwhitespace=true,
  postbreak=\usebox\upb@wrapmark,
  numbers=none,numberstyle=\color{upbGray}\fontsize{6.5}{8}\selectfont,numbersep=2mm,
  escapeinside={(*@}{@*)},
  literate={`}{{\upb@backtick}}1 {→}{{$\rightarrow$}}1 {←}{{$\leftarrow$}}1 {≥}{{$\geq$}}1 {≤}{{$\leq$}}1
           {·}{{$\cdot$}}1 {…}{{\dots}}1 {ș}{{\c{s}}}1 {ț}{{\c{t}}}1 {ă}{{\u{a}}}1 {â}{{\^{a}}}1 {î}{{\^{\i}}}1
}
% \begin{codeblock}[language=Dart,numbers=left] ... \end{codeblock}   (frame must be [fragile])
\lstnewenvironment{codeblock}[1][]{\lstset{#1}}{}
\lstnewenvironment{dart}[1][]{\lstset{language=Dart,#1}}{}
\lstnewenvironment{kotlin}[1][]{\lstset{language=Kotlin,#1}}{}
\lstnewenvironment{golang}[1][]{\lstset{language=Go,#1}}{}
\lstnewenvironment{shell}[1][]{\lstset{language=bash,keywordstyle=\color{upbInk},#1}}{}
\lstnewenvironment{yaml}[1][]{\lstset{language=YAML,#1}}{}
% highlight part of a line inside code:  (*@\hl{text}@*)
\newcommand\hl[1]{{\setlength\fboxsep{0.8pt}\colorbox{upbAccent!15}{\color{upbInk}#1}}}

% ------------------------------------------------------ lab tools -----------
% \begin{steps} \item ... \end{steps}       numbered, one requirement per step
\newenvironment{steps}{\begin{enumerate}}{\end{enumerate}}
% \begin{checklist} \item ... \end{checklist}   acceptance criteria, ruled like a sign-off
% form: a strong rule on top, a hairline under every criterion.
\newif\ifupb@firstcheck
\newenvironment{checklist}{%
  \par\vskip 0.6mm\upb@rule{0.8pt}\vskip 1.6mm\upb@firstchecktrue
  \begin{list}{\color{upbAccent}\faSquare[regular]}{%
    \setlength\leftmargin{6mm}\setlength\labelwidth{4.5mm}\setlength\labelsep{1.5mm}%
    \setlength\itemsep{0pt}\setlength\parsep{0pt}\setlength\topsep{0pt}\raggedright}%
  \let\upb@item\item
  \renewcommand\item{\ifupb@firstcheck\upb@firstcheckfalse\else\par\vskip 1.4mm\upb@vhairline\vskip 1.4mm\fi\upb@item}}%
  {\par\vskip 1.4mm\upb@vhairline\end{list}}
% \trouble{error text}{what to do}   one row of a troubleshooting table
\NewDocumentCommand\trouble{m m}{%
  \noindent\begin{minipage}[t]{0.40\textwidth}\raggedright\ttfamily\fontsize{8}{10}\selectfont #1\end{minipage}\hfill
  \begin{minipage}[t]{0.56\textwidth}\raggedright\usebeamerfont{small}\leavevmode\color{upbInkSoft}#2\end{minipage}%
  {\setlength\parskip{0pt}\par\vskip 1.4mm\upb@vhairline\vskip 1.4mm}}
% \taskmeta{Time}{2 hours}{Submit}{branch lab-3}  small meta row
\NewDocumentCommand\taskmeta{m m m m}{%
  \par\upb@vhairline\vskip 1.8mm
  \noindent\begin{minipage}[t]{0.47\textwidth}\kv{#1}{#2}\end{minipage}\hfill
  \begin{minipage}[t]{0.47\textwidth}\kv{#3}{#4}\end{minipage}\par\vskip 3mm}

% ------------------------------------------------------ flow diagram ------
% \begin{flow}[3] \stage{Board}{TinyGo publisher} \edge[MQTT] \stage{Broker}{Mosquitto} ... \end{flow}
\newlength\upb@stagew
\newcounter{upb@flow}
\newenvironment{flow}[1][3]{%
  \par\vskip 1mm\stepcounter{upb@flow}\setlength\upb@stagew{\dimexpr(\textwidth-19mm*\numexpr#1-1\relax)/#1-0.5pt\relax}%
  \noindent\begin{minipage}{\textwidth}\centering\setlength\parskip{0pt}\ignorespaces}%
  {\end{minipage}\par\vskip 1mm}
\NewDocumentCommand\stage{m m}{%
  \begin{tcolorbox}[enhanced,width=\upb@stagew,box align=center,nobeforeafter,equal height group=upbflow\theupb@flow,
    colback=upbWhite,colframe=upbInk,boxrule=0.6pt,sharp corners,left=2.5mm,right=2.5mm,top=2mm,bottom=2mm,
    boxsep=0pt,fontupper=\upb@nohyph]
    {\upb@sb #1\par}\vskip 0.6mm{\color{upbInkSoft}\usebeamerfont{small}#2\par}
  \end{tcolorbox}\ignorespaces}
\NewDocumentCommand\edge{O{}}{%
  \begin{tikzpicture}[baseline=-0.6ex]
    \draw[upbInk,line width=0.7pt,-{Latex[length=2mm,width=1.6mm]}] (1mm,0) -- (18mm,0);
    \node[above=0.8mm,inner sep=0pt,text width=17mm,align=center,font=\fontsize{7}{8}\selectfont\color{upbInkSoft}] at (9.5mm,0) {#1};
  \end{tikzpicture}\ignorespaces}

